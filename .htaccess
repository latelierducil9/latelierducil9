# ===============================================================
#  RÉGLAGES DU SERVEUR — L'atelier du cil à cil
# ===============================================================
#
#  Ce fichier donne des instructions à l'hébergeur (Hostinger).
#  Il ne change rien à l'apparence du site : il s'occupe de la
#  sécurité, de la vitesse de chargement et des adresses.
#
#  ⚠️ Si le site devient inaccessible juste après sa mise en ligne,
#  renommez ce fichier en « htaccess-desactive.txt » depuis le
#  gestionnaire de fichiers Hostinger : le site refonctionnera
#  immédiatement, et on cherchera la cause tranquillement.
# ===============================================================


# ---------------------------------------------------------------
#  1. Pas de liste des fichiers
# ---------------------------------------------------------------
#  Sans cette ligne, ouvrir /assets/ afficherait la liste de toutes
#  les photos du site comme dans un dossier.
Options -Indexes


# ---------------------------------------------------------------
#  2. Toujours en https (cadenas dans le navigateur)
# ---------------------------------------------------------------
#  Une visiteuse qui tape « latelierducilacil.com » sans https est
#  redirigée vers la version sécurisée. Indispensable : sans cela,
#  les navigateurs affichent « Site non sécurisé » sur la page de
#  paiement.
#
#  ⚠️ À n'activer qu'une fois le certificat SSL installé chez
#  Hostinger (il l'est par défaut, mais vérifiez que le site
#  s'ouvre bien en https avant de compter dessus).
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>


# ---------------------------------------------------------------
#  3. Fichiers qui ne doivent jamais s'ouvrir dans un navigateur
# ---------------------------------------------------------------
#  config.php contient les clés Stripe et Resend. Normalement PHP
#  l'exécute et n'affiche rien, mais si PHP tombe en panne un jour,
#  le serveur enverrait son contenu en clair — et les clés avec.
#  Cette règle empêche ce scénario.
#
#  Les autres fichiers listés sont des « boîtes à outils » utilisées
#  par les pages : les ouvrir directement n'a aucun intérêt.
<FilesMatch "^(config\.php|config\.example\.php|lib\.php|carte\.php|prestations-data\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

#  Fichiers techniques qui ne devraient jamais se retrouver en ligne,
#  bloqués par précaution au cas où ils seraient copiés par erreur.
<FilesMatch "^(\.gitignore|\.env|composer\.(json|lock)|.*\.md|.*\.log|.*\.sqlite.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

#  Le dossier .git contient tout l'historique du code. S'il est copié
#  sur le serveur par mégarde, n'importe qui pourrait le télécharger.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git - [F,L]
    RewriteRule /\.git - [F,L]
</IfModule>


# ---------------------------------------------------------------
#  4. Protections du navigateur
# ---------------------------------------------------------------
<IfModule mod_headers.c>
    # Empêche d'afficher le site dans une fenêtre cachée sur un autre
    # site, technique utilisée pour piéger les clics.
    Header always set X-Frame-Options "SAMEORIGIN"

    # Empêche le navigateur de « deviner » le type d'un fichier.
    Header always set X-Content-Type-Options "nosniff"

    # Ne transmet pas l'adresse exacte de la page consultée aux sites
    # extérieurs (Square, Instagram) — seulement le nom du domaine.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Le site n'a besoin ni du micro, ni de la caméra, ni de la
    # position : on le déclare, les navigateurs bloqueront toute
    # tentative.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>


# ---------------------------------------------------------------
#  5. Chargement plus rapide
# ---------------------------------------------------------------
#  Compression des textes : divise par trois le poids des pages.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

#  Mise en mémoire chez la visiteuse : les photos et le style ne sont
#  téléchargés qu'une fois. Les pages, elles, restent toujours à jour.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>


# ---------------------------------------------------------------
#  6. Encodage des textes
# ---------------------------------------------------------------
#  Garantit que les accents s'affichent correctement partout.
AddDefaultCharset UTF-8
