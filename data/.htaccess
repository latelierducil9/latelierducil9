# ===============================================================
#  Interdiction d'accès public à ce dossier
# ===============================================================
#  Ce dossier contient le fichier des cartes cadeaux vendues
#  (noms, e-mails, codes). Personne ne doit pouvoir y accéder
#  depuis un navigateur, même en devinant le nom du fichier.
#
#  Les deux blocs ci-dessous couvrent les anciennes et les
#  nouvelles versions d'Apache / LiteSpeed (Hostinger).
# ===============================================================

# Apache 2.4 et LiteSpeed
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (ancien)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
